  { id: 'sec_36', title: "Get rid of digestive discomfort" },
  { id: 'sec_37', title: "Pamper yourself before bed" },
  { id: 'sec_38', title: "For a good night sleep" },
  { id: 'sec_39', title: "Stock up on crunchy snacks" },
  { id: 'sec_40', title: "Get lost in the realm of music" },
  { id: 'sec_41', title: "Lightning deals" },
  { id: 'sec_42', title: "Create a relaxing ambiance" },
  { id: 'sec_43', title: "Lose yourself in a world of love" },
  { id: 'sec_44', title: "Elevate your bathroom essentials" },
  { id: 'sec_45', title: "Sustainable menstrual solutions" },
  { id: 'sec_46', title: "Hydrate and nourish your skin" },
  { id: 'sec_47', title: "Beard styling made easy" },
  { id: 'sec_48', title: "Instant Freshness Anytime" },
  { id: 'sec_49', title: "Keep your bathroom fresh and germ-free" }
];


export default function App() {
  const { width: windowWidth, height: windowHeight } = useWindowDimensions();

  // Screens: 'auth' | 'main' | 'tracking' | 'orders' | 'profile' | 'support' | 'addresses'
  const [currentScreen, setCurrentScreen] = useState<'auth' | 'main' | 'tracking' | 'orders' | 'profile' | 'support' | 'addresses'>('auth');
  const [trackingOrderId, setTrackingOrderId] = useState<string | null>(null);

  const [email, setEmail] = useState('');
  const [otpSent, setOtpSent] = useState(false);
  const [otpCode, setOtpCode] = useState('');
  const [isLoadingSession, setIsLoadingSession] = useState(true);
  const [isAuthenticating, setIsAuthenticating] = useState(false);
  const [resendCooldown, setResendCooldown] = useState(0);
  const [loyaltyPoints, setLoyaltyPoints] = useState(0);
  const [sessionUser, setSessionUser] = useState<any>(null);

  const { cart, updateCart, clearCart, addresses, walletBalance, setWalletBalance, products, activeAddress, servingWarehouseId } = useMobileApp(sessionUser?.id || null);

  useEffect(() => {
    supabase.auth.getSession().then(({ data: { session } }) => {
      if (session) {
        verifyAndLoadProfile(session.user);
      } else {
        setIsLoadingSession(false);
      }
    });

    const { data: { subscription } } = supabase.auth.onAuthStateChange((_event, session) => {
      if (session) {
        verifyAndLoadProfile(session.user);
      } else {
        setSessionUser(null);
        setCurrentScreen('auth');
        setIsLoadingSession(false);
      }
    });

    return () => {
      subscription.unsubscribe();
    };
  }, []);

  const verifyAndLoadProfile = async (user: any) => {
    try {
      const { data, error } = await supabase
        .from('profiles')
        .select('*')
        .eq('id', user.id)
        .single();
      
      if (error || !data) {
        Alert.alert('Error', 'Profile not found. Contact support.');
        await supabase.auth.signOut();
        setCurrentScreen('auth');
        return;
      }
      
      if (data.role !== 'customer') {
        Alert.alert('Unauthorized', 'Access restricted to customers only.');
        await supabase.auth.signOut();
        setCurrentScreen('auth');
        return;
      }

      if (data.is_suspended) {
        Alert.alert('Suspended', 'Your account has been suspended.');
        await supabase.auth.signOut();
        setCurrentScreen('auth');
        return;
      }
      
      setSessionUser(user);
      setCurrentScreen('main');
    } catch (err) {
      console.error(err);
      setCurrentScreen('auth');
    } finally {
      setIsLoadingSession(false);
    }
  };
  
  const [isVip, setIsVip] = useState(false);
  const [searchQuery, setSearchQuery] = useState('');
  const [selectedCategory, setSelectedCategory] = useState<string | null>(null);

  const [couponCode, setCouponCode] = useState('');
  const [appliedDiscount, setAppliedDiscount] = useState(0); 
  const [isCartOpen, setIsCartOpen] = useState(false);

  const [trackingStep, setTrackingStep] = useState<'placed' | 'picking' | 'packed' | 'shipping' | 'delivered'>('placed');
  
  const [riderProgress, setRiderProgress] = useState(0);
  const [etaMinutes, setEtaMinutes] = useState(10);
  
  const cartAnim = useState(() => new Animated.Value(SCREEN_HEIGHT))[0];

  useEffect(() => {
    Animated.timing(cartAnim, {
      toValue: isCartOpen ? 0 : SCREEN_HEIGHT,
      duration: 350,
      useNativeDriver: true
    }).start();
  }, [isCartOpen]);

  useEffect(() => {
    setIsVip(loyaltyPoints >= 200);
  }, [loyaltyPoints]);

  const handleSendOtp = async () => {
    if (!email.includes('@')) {
      Alert.alert('Invalid Email', 'Please enter a valid email address');
      return;
    }
    setIsAuthenticating(true);
    const { error } = await supabase.auth.signInWithOtp({ email: email.trim() });
    setIsAuthenticating(false);
    
    if (error) {
      Alert.alert('Error', error.message);
      return;
    }
    
    setOtpSent(true);
    setResendCooldown(60);
    const interval = setInterval(() => {
      setResendCooldown(prev => {
        if (prev <= 1) { clearInterval(interval); return 0; }
        return prev - 1;
      });
    }, 1000);
  };

  const handleVerifyOtp = async () => {
    if (otpCode.length !== 6) {
      Alert.alert('Invalid OTP', 'Please enter the 6-digit code');
      return;
    }
    setIsAuthenticating(true);
    const { data, error } = await supabase.auth.verifyOtp({ email: email.trim(), token: otpCode, type: 'email' });
    setIsAuthenticating(false);
    if (error) { Alert.alert('Verification Failed', error.message); return; }
    if (data.user) { await verifyAndLoadProfile(data.user); }
  };

  const handleUpdateCart = (id: string, delta: number) => {
    const currentQty = cart[id] || 0;
    const newQty = currentQty + delta;
    updateCart(id, newQty);
  };

  const cartItemsCount = Object.values(cart).reduce((a, b) => a + b, 0);
  const subtotal = Object.entries(cart).reduce((sum, [id, qty]) => {
    const p = products.find(prod => prod.id === id);
    return sum + (p ? p.price * qty : 0);
  }, 0);

  const discountAmount = subtotal * (appliedDiscount / 100);
  const deliveryFee = subtotal > 15 ? 0 : 4.99; // Free delivery threshold
  const totalBill = subtotal - discountAmount + deliveryFee;

  const handleApplyCoupon = async () => {
    try {
      const coupons = await getCoupons();
      const valid = coupons.find(c => c.code.toUpperCase() === couponCode.toUpperCase());
      if (valid && subtotal >= valid.min_order_value) {
        setAppliedDiscount(valid.discount_value);
        Alert.alert('Coupon Applied', `Code ${valid.code} gives you ${valid.discount_value}% discount!`);
      } else {
        Alert.alert('Invalid Coupon', 'Coupon not found or minimum order value not met.');
      }
    } catch (err) {
      Alert.alert('Error', 'Failed to validate coupon.');
    }
  };

  const handleCheckout = async () => {
    if (walletBalance < totalBill) {
      Alert.alert('Insufficient Balance', 'Please top up your wallet funds first!');
      return;
    }
    
    if (addresses.length === 0) {
      Alert.alert('No Address', 'Please add an address before checkout.');
      return;
    }

    try {
      const items = Object.entries(cart).map(([productId, quantity]) => ({ productid: productId, quantity }));
      
      const payload = {
        p_user_id: sessionUser.id,
        p_address: addresses[0].address_line1 || 'Main Address',
        p_lat: addresses[0].lat || 13.3427,
        p_lng: addresses[0].lng || 74.7472,
        p_items: items,
        p_discount_val: appliedDiscount,
        p_coupon_code: couponCode || null,
        p_delivery_fee: deliveryFee,
        p_delivery_speed: 'standard',
        p_payment_method: 'wallet',
        p_idempotency_key: Date.now().toString()
      };

      const orderId = await processCheckout(payload);
      
      // Clear cart on success
      await clearCart();
      setIsCartOpen(false);
      
      // Debit local balance for instant UI update, though real balance is updated in DB
      setWalletBalance(prev => prev - totalBill);

      setCurrentScreen('tracking');
    } catch (err: any) {
      Alert.alert('Checkout Failed', err.message);
    }
  };

  // Filtered lists
  const filteredProducts = products.filter(p => {
    const matchesSearch = p.name.toLowerCase().includes(searchQuery.toLowerCase());
    const matchesCategory = selectedCategory ? p.category_id === selectedCategory : true;
    return matchesSearch && matchesCategory;
  });

  const numCols = windowWidth >= 1024 ? Math.max(4, Math.floor((windowWidth - 32) / 180)) : windowWidth >= 768 ? Math.max(3, Math.floor((windowWidth - 32) / 160)) : 2;
  const dynamicCardWidth = (windowWidth - 32 - (12 * (numCols - 1))) / numCols;

  return (
    <SafeAreaView style={styles.container}>
      <StatusBar barStyle="light-content" />

      {/* -------------------- 1. AUTH SCREEN -------------------- */}
      {currentScreen === 'auth' && (
        <AuthScreen 
          email={email} setEmail={setEmail}
          otpCode={otpCode} setOtpCode={setOtpCode}
          otpSent={otpSent} setOtpSent={setOtpSent}
          isLoadingSession={isLoadingSession} isAuthenticating={isAuthenticating}
          resendCooldown={resendCooldown}
          handleSendOtp={handleSendOtp} handleVerifyOtp={handleVerifyOtp}
        />
      )}

      {/* -------------------- DESKTOP HEADER -------------------- */}
      {windowWidth >= 1024 && currentScreen !== 'auth' && (
        <View style={styles.desktopHeader}>
          <View style={styles.desktopHeaderLeft}>
            <Text style={styles.desktopLogo}>FlashGO</Text>
            <View style={styles.desktopLocation}>
              <MapPin size={16} color={theme.colors.textMuted} />
              <Text style={styles.desktopLocationText}>Delivering to <Text style={{fontWeight: 'bold', color: theme.colors.text}}>Home</Text></Text>
            </View>
          </View>
          <View style={styles.desktopHeaderSearch}>
            <Search size={20} color={theme.colors.textMuted} />
            <TextInput 
              style={styles.desktopSearchInput} 
              placeholder="Search for groceries, vegetables, and more..." 
              value={searchQuery}
              onChangeText={setSearchQuery}
            />
          </View>
          <View style={styles.desktopHeaderRight}>
            <TouchableOpacity style={styles.desktopIconBtn} onPress={() => setCurrentScreen('orders')}>
              <Package size={20} color={theme.colors.text} />
              <Text style={styles.desktopIconText}>Orders</Text>
            </TouchableOpacity>
            <TouchableOpacity style={styles.desktopIconBtn} onPress={() => setCurrentScreen('support')}>
              <HeadphonesIcon size={20} color={theme.colors.text} />
              <Text style={styles.desktopIconText}>Support</Text>
            </TouchableOpacity>
            <TouchableOpacity style={styles.desktopIconBtn} onPress={() => setCurrentScreen('profile')}>
              <User size={20} color={theme.colors.text} />
              <Text style={styles.desktopIconText}>Profile</Text>
            </TouchableOpacity>
            <TouchableOpacity style={styles.desktopCartBtn} onPress={() => setIsCartOpen(true)}>
              <ShoppingBag size={20} color={theme.colors.surface} />
              <Text style={styles.desktopCartText}>{cartItemsCount} Items</Text>
            </TouchableOpacity>
          </View>
        </View>
      )}

      {/* -------------------- 2. CUSTOMER PORTAL -------------------- */}
      {currentScreen === 'profile' && <ProfileScreen sessionUser={sessionUser} onNavigate={(s) => setCurrentScreen(s as any)} />}
      {currentScreen === 'orders' && <OrdersScreen onNavigateToTracking={(id) => { setTrackingOrderId(id); setCurrentScreen('tracking'); }} />}
      {currentScreen === 'support' && <SupportScreen onBack={() => setCurrentScreen('main')} />}
      {currentScreen === 'addresses' && <AddressesScreen onBack={() => setCurrentScreen('profile')} />}
      {currentScreen === 'tracking' && <TrackingScreen route={{ params: { orderId: trackingOrderId } }} onBack={() => setCurrentScreen('orders')} />}

      {currentScreen === 'main' && (
        <View style={{ flex: 1 }}>
          <HomeScreen 
            products={products} categories={Object.keys(CATEGORY_ICONS)} categoryIcons={CATEGORY_ICONS}
            activeCategory={selectedCategory} setActiveCategory={setSelectedCategory}
            searchQuery={searchQuery} setSearchQuery={setSearchQuery}
            cart={cart} handleUpdateCart={handleUpdateCart}
            handleLogout={async () => {
              setIsLoadingSession(true);
              await supabase.auth.signOut();
              setCurrentScreen('auth');
            }}
          />

          {cartItemsCount > 0 && (
            <TouchableOpacity style={styles.floatingCart} onPress={() => setIsCartOpen(true)}>
              <ShoppingBag size={20} color="#ffffff" />
              <View style={{ flex: 1, marginLeft: 12 }}>
                <Text style={styles.floatingCartTitle}>{cartItemsCount} Items in Basket</Text>
                <Text style={styles.floatingCartSub}>Fast delivery active</Text>
              </View>
              <Text style={styles.floatingCartTotal}>₹{totalBill.toFixed(2)}</Text>
              <ChevronRight size={18} color="#ffffff" />
            </TouchableOpacity>
          )}

          {/* FlashGO Bottom Navigation (Mobile Only) */}
          {windowWidth < 1024 && (
            <View style={styles.bottomNav}>
              <TouchableOpacity style={styles.navItem} onPress={() => setCurrentScreen('main')}>
                <HomeIcon size={24} color="#10b981" />
                <Text style={[styles.navText, { color: '#10b981' }]}>Home</Text>
              </TouchableOpacity>
              <TouchableOpacity style={styles.navItem} onPress={() => setCurrentScreen('orders')}>
                <Package size={24} color="#64748b" />
                <Text style={styles.navText}>Orders</Text>
              </TouchableOpacity>
              <TouchableOpacity style={styles.navItem} onPress={() => setCurrentScreen('support')}>
                <HeadphonesIcon size={24} color="#64748b" />
                <Text style={styles.navText}>Support</Text>
              </TouchableOpacity>
              <TouchableOpacity style={styles.navItem} onPress={() => setCurrentScreen('profile')}>
                <User size={24} color="#64748b" />
                <Text style={styles.navText}>Profile</Text>
              </TouchableOpacity>
            </View>
          )}

          {isCartOpen && (
            <CartSheet 
              cart={cart} products={products}
              subtotal={subtotal} deliveryFee={deliveryFee}
              appliedDiscount={appliedDiscount} discountAmount={discountAmount} totalBill={totalBill}
              walletBalance={walletBalance} couponCode={couponCode} setCouponCode={setCouponCode}
              handleApplyCoupon={handleApplyCoupon} handleCheckout={handleCheckout}
              setIsCartOpen={setIsCartOpen}
            />
          )}
        </View>
      )}
    </SafeAreaView>
  );
}

