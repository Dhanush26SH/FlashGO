  munchies: '🍿',
  dairy: '🥛',
  veg: '🥗',
  bakery: '🍞',
  beverage: '🥤',
  personalcare: '🧴',
  household: '🧹',
  sweet: '🍫'
};

// Initial Mock Products
interface Product {
  id: string;
  category_id: string;
  name: string;
  description: string;
  price: number;
  discount_price?: number;
  sku: string;
  barcode: string;
  image_url: string;
  stock_quantity: number;
  warehouse_location: string;
  rating_avg: number;
  rating_count: number;
  created_at?: string;
}


