  { id: 'sec_24', title: "Unwind & chill" },
  { id: 'sec_25', title: "Rice for everyday meals" },
  { id: 'sec_26', title: "Power up your hygiene routine" },
  { id: 'sec_27', title: "Take care of those you love" },
  { id: 'sec_28', title: "Refreshing drinks for summer" },
  { id: 'sec_29', title: "Set the scene for a movie night" },
  { id: 'sec_30', title: "Cooking ideas" },
  { id: 'sec_31', title: "Travel with comfort" },
  { id: 'sec_32', title: "Study smarter at night" },
  { id: 'sec_33', title: "Audio accessories for daily use" },
  { id: 'sec_34', title: "Sudden hunger pangs?" },
