-- 3. Assert zero products reference four obsolete categories
DO $$ 
DECLARE 
  obsolete_count INT;
BEGIN
  SELECT count(*) INTO obsolete_count FROM products WHERE category_id IN (
    'c0000000-0000-0000-0000-000000000003',
    'c0000000-0000-0000-0000-000000000004',
    'c0000000-0000-0000-0000-000000000005',
    'c0000000-0000-0000-0000-000000000006'
  );
  IF obsolete_count > 0 THEN
    RAISE EXCEPTION 'Products still reference obsolete categories';
  END IF;
END $$;

-- 4. Delete four obsolete categories
DELETE FROM categories WHERE id IN (
  'c0000000-0000-0000-0000-000000000003',
  'c0000000-0000-0000-0000-000000000004',
  'c0000000-0000-0000-0000-000000000005',
  'c0000000-0000-0000-0000-000000000006'
);

-- 5. Assert category count = 26
DO $$
DECLARE
  cat_count INT;
BEGIN
  SELECT count(*) INTO cat_count FROM categories;
  IF cat_count != 26 THEN
    RAISE EXCEPTION 'Expected 26 categories, got %', cat_count;
  END IF;
END $$;

-- 6. Assert product count unchanged
DO $$
DECLARE
  prod_count INT;
BEGIN
  SELECT count(*) INTO prod_count FROM products;
  IF prod_count != 209 THEN
    RAISE EXCEPTION 'Expected 209 products, got %', prod_count;
  END IF;
END $$;

COMMIT;
